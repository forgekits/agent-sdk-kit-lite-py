# Required. The Agent SDK authenticates with an Anthropic API key.
# Anthropic does not permit third-party products to use claude.ai subscription login.
ANTHROPIC_API_KEY=

# Optional. Model alias or full model ID. Default: claude-opus-5-5
AGENT_MODEL=claude-opus-5-5

# Optional. Hard limits for a single run. Defaults: 12 turns, 0.50 USD.
AGENT_MAX_TURNS=12
AGENT_MAX_BUDGET_USD=0.50

# Optional. Where the notes tool stores its JSONL file. Default: ./data/notes
NOTES_DIR=./data/notes

# Optional. debug | info | warn | error. Default: info
LOG_LEVEL=info
